# ===== Python =====
__pycache__/
*.pyc
*.pyo
venv/
.env

# ===== 数据库与日志（本地数据，不入库；运行时自动创建） =====
backend/data/*.db
backend/data/*.db-journal
backend/data/*.log
backend/data/backups/
# 腾讯云 COS 密钥配置（含 SecretId/SecretKey，严禁入库；模板见 cos.example.json）
backend/data/cos.json
*.log

# ===== 临时日志 =====
*.log
uvicorn.err

# ===== 冒烟测试下载产物 =====
_dl_test.json

# ===== 部署发布包（不入库） =====
# publish/ 内含固定会话签名密钥（config.py 的 SECRET_KEY 明文）与含用户数据的 app.db，
# 若仓库公开会造成 token 伪造风险与数据泄露。部署配方见项目记忆文档。
/publish/

# ===== 根目录临时/调试文件（下划线前缀） =====
/_*.js
/_*.html
/_*.txt
/_chk_*.js
/_test_*.py

# ===== 后端一次性维护脚本 =====
/backend/_*.py

# ===== 运行时生成的密钥/进程文件（含 JWT 密钥，严禁入库） =====
/backend/.secret
/backend/server.pid
/backend/server.log

# ===== 项目记忆（不入库） =====
.workbuddy/
